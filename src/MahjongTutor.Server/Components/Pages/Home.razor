@page "/"
@using MahjongTutor.Server.Cards
@inject ICardStore Store

<PageTitle>MahjongTutor</PageTitle>

<h1>MahjongTutor</h1>
<p>American Mahjong practice and coaching — full NMJL rules, bots, and network play.</p>

@if (_active != null)
{
    <div class="notice ok">
        Active card: <strong>@_active.Name</strong> (@_active.Year) — @_active.AllHands.Count() hands
    </div>
}
else
{
    <div class="notice warn">
        No active card yet — <a href="/cards">enter your yearly card</a> to unlock games and coaching.
    </div>
}

@code {
    private Core.Card.MahjongCard? _active;

    protected override async Task OnInitializedAsync()
    {
        _active = await Store.GetActiveAsync();
    }
}
