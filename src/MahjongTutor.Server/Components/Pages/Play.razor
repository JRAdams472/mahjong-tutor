@page "/play"
@using MahjongTutor.Core.Bots
@using MahjongTutor.Core.Coach
@using MahjongTutor.Core.Rules
@using MahjongTutor.Core.Tiles
@using MahjongTutor.Server.Game
@using MahjongTutor.Server.Tiles
@inject GameSession Session
@inject SavedGameStore Saves
@inject OllamaCoach Ollama
@inject TileSetManager Tiles
@inject IConfiguration Cfg

<PageTitle>Play — MahjongTutor</PageTitle>

@if (Engine == null)
{
    <h1>Play vs bots</h1>
    <button class="btn primary" @onclick="Start">New game</button>
    @if (_error != null) { <div class="notice bad">@_error</div> }

    <h2>Saved games</h2>
    @foreach (var g in _saved)
    {
        <div class="fit">
            <b>@g.Name</b> · @g.UpdatedUtc.ToLocalTime().ToString("g")
            <button class="btn small" @onclick="() => Resume(g.Id)">Resume</button>
            <button class="btn small" @onclick="() => DeleteSaved(g.Id)">Delete</button>
        </div>
    }
}
else
{
    var s = Engine.State;
    <div class="playgrid">
        <GameTable State="s" Seat="0" Error="@_error"
                   OnPass="t => Act(() => Session.HumanPassAsync(t))"
                   OnCourtesy="t => Act(() => Session.HumanCourtesyAsync(t))"
                   OnVote="v => Act(() => Session.HumanVoteAsync(v))"
                   OnDraw="() => Act(() => Session.HumanDrawAsync())"
                   OnDiscard="t => Act(() => Session.HumanDiscardAsync(t))"
                   OnClaim="k => Act(() => Session.HumanClaimAsync(k))"
                   OnMahjong="() => Act(() => Session.HumanMahjongAsync())"
                   OnExchange="x => Act(() => Session.HumanExchangeAsync(x.owner, x.meld, x.natural))"
                   Log="Session.Log" Notes="Session.Notes" />

        @* coach panel *@
        <div class="coach">
            <h3>Coach</h3>
            <div class="suggest">@Suggestion(s)
                @if (_piperOn && Engine != null)
                {
                    <button class="btn small" @onclick="Speak">🔊 speak</button>
                    @if (_speakUrl != null) { <audio src="@_speakUrl" autoplay controls style="width:100%;height:28px" /> }
                }
            </div>
            @if (Ollama.Enabled)
            {
                <div class="toolbar">
                    <input class="input grow" placeholder="ask the coach…" @bind="_ask" />
                    <button class="btn small" @onclick="Ask">Ask</button>
                </div>
                @if (_answer != null) { <div class="cnote">@_answer</div> }
            }
            <h4>Best targets</h4>
            @foreach (var f in CoachBrain.TopFits(s, 0, 3))
            {
                <div class="fit @(f.Viable ? "" : "dead")">
                    <b>@f.Hand.Id</b> · @f.Hand.Points pts · @f.TilesNeeded out
                    <div class="missing">
                        needs:
                        @foreach (var t in f.Missing) { <TileImg TileKind="t" /> }
                        @foreach (var r in f.MissingAnySuit) { <span class="chip">any @r</span> }
                    </div>
                </div>
            }
            <h4>Opponents</h4>
            @{ var reads = Defense.Reads(s, 0); }
            @if (reads.Count == 0)
            {
                <div class="dim">No exposures yet — nothing to infer.</div>
            }
            @foreach (var r in reads)
            {
                <div class="fit">
                    <b>Seat @r.Seat</b> likely:
                    @foreach (var h in r.Likely) { <span class="chip">@h.Id</span> }
                </div>
            }
            <h4>Save</h4>
            <div class="toolbar">
                <input class="input grow" placeholder="save name" @bind="_saveName" />
                <button class="btn small" @onclick="Save">Save</button>
            </div>
            <h4>Notes</h4>
            @foreach (var n in Session.Notes.Take(6))
            {
                <div class="cnote @n.Severity">@n.Text</div>
            }
        </div>
    </div>
}

@code {
    private GameEngine? Engine;
    private string? _error;
    private string _saveName = "";
    private string _ask = "";
    private string? _answer;
    private bool _piperOn;
    private string? _speakUrl;

    private void Speak()
    {
        if (Engine == null) return;
        var s = Suggestion(Engine.State).Value;
        var text = System.Text.RegularExpressions.Regex.Replace(s, "<[^>]+>", "");
        _speakUrl = "/speak?text=" + Uri.EscapeDataString(text);
    }

    private async Task Ask()
    {
        if (Engine == null) return;
        var s = Engine.State;
        var ctx = $"My tiles: {Codes(s.Seats[0].Concealed.ToList())}.\n" +
                  $"Exposures: {string.Join(" | ", s.Seats[0].Exposures.Select(m => Codes(m.Tiles)))}.\n" +
                  $"Coach's current advice: {Suggestion(s).Value}.\n" +
                  $"Best fits: {string.Join("; ", CoachBrain.TopFits(s, 0, 3).Select(f => $"{f.Hand.Id} ({f.TilesNeeded} out)"))}.";
        _answer = "…";
        _answer = await Ollama.AskAsync(ctx, string.IsNullOrWhiteSpace(_ask) ? "what should I do?" : _ask);
        _ask = "";
    }
    private List<MahjongTutor.Server.Data.SavedGame> _saved = [];

    protected override async Task OnInitializedAsync()
    {
        _saved = await Saves.ListAsync();
        _piperOn = !string.IsNullOrEmpty(Cfg["Piper:Url"]);
    }

    private async Task Save()
    {
        _error = null;
        try { await Session.SaveAsync(string.IsNullOrWhiteSpace(_saveName) ? "save" : _saveName); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Resume(int id)
    {
        _error = null;
        if (!await Session.LoadAsync(id)) { _error = "Couldn't load that save."; return; }
        Engine = Session.Engine;
    }

    private async Task DeleteSaved(int id)
    {
        await Saves.DeleteAsync(id);
        _saved = await Saves.ListAsync();
    }

    private async Task Start()
    {
        _error = null;
        try { Engine = await Session.StartAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private MarkupString Suggestion(GameState s)
    {
        if (s.Phase == GamePhase.Finished) return new("Game over.");
        if (s.Phase == GamePhase.Charleston)
        {
            if (s.CharlestonStage == CharlestonStage.Vote) return new("Second Charleston? Coach votes by hand messiness.");
            if (s.PendingPasses.ContainsKey(0)) return new("Waiting on the other players…");
            var pass = CoachBrain.SuggestPass(s, 0);
            return new($"Coach suggests passing: {Codes(pass)}");
        }
        if (s.Stage == TurnStage.CallWindow && s.PendingOptions.TryGetValue(0, out var opts)
            && !s.PendingResponded.Contains(0))
        {
            if (opts.Contains(ClaimKind.Mahjong)) return new("<b>You can win — Mahjong!</b>");
            var note = CoachBrain.MissedCallNote(s, 0, s.PendingDiscard!.Value);
            return new(note ?? "Nothing worth calling — pass.");
        }
        if (s.CurrentSeat == 0 && s.Stage == TurnStage.AwaitDiscard)
        {
            var d = CoachBrain.SuggestPass(s, 0, 1);
            var warn = Defense.DangerNote(s, 0, d[0]);
            return new($"Coach would discard: <b>{d[0].Code()}</b>" +
                       (warn != null ? $" — <span class='warn'>{warn}</span>" : ""));
        }
        return new("Waiting…");
    }

    private static string Codes(IEnumerable<Tile> ts) =>
        string.Join(" ", ts.Select(t => t.Code()));

    private async Task Act(Func<Task> action)
    {
        _error = null;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
    }
}
